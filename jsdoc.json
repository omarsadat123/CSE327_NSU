{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": [
      "app.js",
      "controllers",
      "models",
      "routes",
      "configs"
    ],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(node_modules|docs|(^|\\/|\\\\)_)"
  },
  "opts": {
    "encoding": "utf8",
    "destination": "./docs",
    "recurse": true,
    "verbose": true,
    "template": "node_modules/better-docs"
  },
  "plugins": [
    "plugins/markdown"
  ],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true
  }
}
