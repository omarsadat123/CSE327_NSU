{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": [
      "controllers",
      "models",
      "routes",
      "configs",
      "app.js"
    ],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "opts": {
    "encoding": "utf8",
    "destination": "./docs",
    "recurse": true,
    "verbose": true
  }
}
