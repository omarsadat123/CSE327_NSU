<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ProCollab Dashboard</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
  />
  <style>
    .stat-card {
      transition: 0.3s;
    }
    .stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15) !important;
    }
    .hover-shadow:hover {
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2) !important;
      transform: translateY(-3px);
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="#"
        ><i class="bi bi-diagram-3-fill me-2"></i>ProCollab</a
      >
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link fw-semibold active" href="/dashboard"
              ><i class="bi bi-speedometer2 me-1"></i>Dashboard</a
            >
          </li>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/logout"
              ><i class="bi bi-box-arrow-right me-1"></i>Logout</a
            >
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Welcome Section -->
  <div class="bg-light py-4 shadow-sm">
    <div class="container">
      <h3 class="fw-bold mb-1">
        Welcome back, <span class="text-primary"><%= user.name %></span> 👋
      </h3>
      <p class="text-muted mb-0">
        Here’s what’s happening with your projects today.
      </p>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="container mt-4">
    <div class="row g-3">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 text-center h-100 stat-card owned">
          <div class="card-body">
            <i class="bi bi-folder-fill fs-1 text-primary"></i>
            <h5 class="mt-2">Owned Projects</h5>
            <h3 class="fw-bold"><%= projectCounts.owned %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 text-center h-100 stat-card joined">
          <div class="card-body">
            <i class="bi bi-people-fill fs-1 text-success"></i>
            <h5 class="mt-2">Joined Projects</h5>
            <h3 class="fw-bold"><%= projectCounts.joined %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 text-center h-100 stat-card pending">
          <div class="card-body">
            <i class="bi bi-list-check fs-1 text-warning"></i>
            <h5 class="mt-2">Pending Tasks</h5>
            <h3 class="fw-bold"><%= pendingTasksCount %></h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Create Project Button -->
  <div class="container mt-4">
    <button
      class="btn btn-primary w-100 py-3 fw-bold"
      data-bs-toggle="modal"
      data-bs-target="#createProjectModal"
    >
      <i class="bi bi-plus-lg me-2"></i>Create New Project
    </button>
  </div>

  <div class="container mt-4">
    <a
      href=""
      class="btn btn-sm btn-outline-secondary w-100 py-3 fw-bold"
      ><i class="bi bi-person-fill-add"></i>View Invitations</a
    >
  </div>

  <!-- Create Project Modal -->
  <div
    class="modal fade"
    id="createProjectModal"
    tabindex="-1"
    aria-labelledby="createProjectLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="createProjectLabel">
            <i class="bi bi-folder-plus me-2"></i>Create Project
          </h5>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <form action="/projects/create" method="POST">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label" for="projectName">Project Name</label>
              <input
                type="text"
                name="name"
                id="projectName"
                class="form-control"
                required
              />
            </div>
            <div class="mb-3">
              <label class="form-label" for="projectDescription">Description</label>
              <textarea
                name="description"
                id="projectDescription"
                class="form-control"
                rows="3"
              ></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label" for="projectVisibility">Visibility</label>
              <select
                name="visibility"
                id="projectVisibility"
                class="form-select"
                required
              >
                <option value="public">Public</option>
                <option value="private">Private</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label" for="projectStatus">Status</label>
              <select
                name="status"
                id="projectStatus"
                class="form-select"
                required
              >
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>
            </div>
          </div>
          <div class="modal-footer border-0">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
            <button type="submit" class="btn btn-primary">Create Project</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Project Tabs -->
  <div class="container mt-4">
    <ul class="nav nav-tabs" id="projectTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button
          class="nav-link active"
          id="owned-tab"
          data-bs-toggle="tab"
          data-bs-target="#owned"
          type="button"
          role="tab"
          aria-controls="owned"
          aria-selected="true"
        >
          Owned
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button
          class="nav-link"
          id="joined-tab"
          data-bs-toggle="tab"
          data-bs-target="#joined"
          type="button"
          role="tab"
          aria-controls="joined"
          aria-selected="false"
        >
          Joined
        </button>
      </li>
    </ul>
    <div class="tab-content mt-3">
      <!-- Owned Projects -->
      <div
        class="tab-pane fade show active"
        id="owned"
        role="tabpanel"
        aria-labelledby="owned-tab"
      >
        <div class="row g-3">
          <% ownedProjects.forEach(project => { %>
            <div class="col-md-4">
              <div
                class="card h-100 shadow-sm border-0 rounded-3 hover-shadow"
              >
                <div class="card-body">
                  <h5 class="card-title text-primary">
                    <i class="bi bi-folder-fill me-2"></i><%= project.name %>
                  </h5>
                  <a
                    href="/project/<%= project.pid %>"
                    class="btn btn-sm btn-outline-primary mt-2"
                    >Open Project</a
                  >
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Joined Projects -->
      <div
        class="tab-pane fade"
        id="joined"
        role="tabpanel"
        aria-labelledby="joined-tab"
      >
        <div class="row g-3">
          <% joinedProjects.forEach(project => { %>
            <div class="col-md-4">
              <div
                class="card h-100 shadow-sm border-0 rounded-3 hover-shadow"
              >
                <div class="card-body">
                  <h5 class="card-title text-success">
                    <i class="bi bi-people-fill me-2"></i><%= project.name %>
                  </h5>
                  <p class="text-muted mb-1">Owner: <%= project.owner_name %></p>
                  <a
                    href="/project/<%= project.pid %>"
                    class="btn btn-sm btn-outline-success mt-2"
                    >Open Project</a
                  >
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Upcoming Tasks -->
  <div class="container mt-4 mb-5">
    <h5 class="mb-3">
      <i class="bi bi-calendar-event-fill me-2"></i>Upcoming Tasks
    </h5>
    <div class="row g-3">
      <% upcomingTasks.forEach(task => { %>
        <div class="col-md-3">
          <div
            class="card border-0 shadow-sm rounded-3 hover-shadow"
          >
            <div class="card-body">
              <h6 class="card-title text-dark">
                <i class="bi bi-check2-circle me-2"></i><%= task.task_name %>
              </h6>
              <p class="text-muted mb-1">
                <small>Project: <%= task.project_name %></small>
              </p>
              <%
                const deadlineDate = new Date(task.deadline);
                const formattedDate =
                  deadlineDate.getFullYear() +
                  '-' +
                  String(deadlineDate.getMonth() + 1).padStart(2, '0') +
                  '-' +
                  String(deadlineDate.getDate()).padStart(2, '0');
              %>
              <p class="mb-2">
                <small>
                  Deadline:
                  <span class="fw-bold"><%= formattedDate %></span>
                </small>
              </p>
              <a
                href="/project/<%= task.pid %>"
                class="btn btn-sm btn-outline-secondary"
                >View Project</a
              >
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
  ></script>
</body>
</html>
