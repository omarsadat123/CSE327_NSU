<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Project Task Board (Node.js)</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
  />
  <style>
    body {
      background-color: #f8f9fa;
      font-family: 'Inter', sans-serif;
    }
    .task-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
      transition: all 0.2s ease-in-out;
    }
  </style>
</head>
<body>
  <!-- Navbar copied from your dashboard page -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="#">
        <i class="bi bi-diagram-3-fill me-2"></i>ProCollab
      </a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/dashboard">
              <i class="bi bi-speedometer2 me-1"></i>Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/logout">
              <i class="bi bi-box-arrow-right me-1"></i>Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container py-5">
    <header class="text-center mb-5">
      <h1 class="display-5 fw-bold">Project Task Board</h1>
      <% if (projectName) { %>
        <h2 class="h4 fw-semibold text-primary mt-3">
          Project: <%= projectName %>
        </h2>
      <% } %>
    </header>

    <div class="row">
      <!-- Create Task Form -->
      <div class="col-md-4">
        <div class="card sticky-top">
          <div class="card-body">
            <h5 class="card-title">Create New Task</h5>
            <form
              id="create-task-form"
              method="POST"
              action="/projects/<%= projectId %>/tasks/create"
            >
              <div class="mb-3">
                <label for="task-name" class="form-label">Task Name</label>
                <input
                  type="text"
                  id="task-name"
                  name="task_name"
                  class="form-control"
                  required
                  maxlength="255"
                  placeholder="e.g., Design homepage"
                />
              </div>

              <div class="mb-3">
                <label for="task-description" class="form-label"
                  >Description</label
                >
                <textarea
                  id="task-description"
                  name="task_description"
                  class="form-control"
                  rows="4"
                  placeholder="Add more details..."
                ></textarea>
              </div>

              <div class="mb-3">
                <label for="task-status" class="form-label">Status</label>
                <select
                  id="task-status"
                  name="task_status"
                  class="form-select"
                >
                  <option value="Pending">Pending</option>
                  <option value="In Progress">In Progress</option>
                  <option value="Completed">Completed</option>
                </select>
              </div>

              <div class="mb-3">
                <label for="task-priority" class="form-label">Priority</label>
                <select
                  id="task-priority"
                  name="task_priority"
                  class="form-select"
                >
                  <option value="Low">Low</option>
                  <option value="Medium" selected>Medium</option>
                  <option value="High">High</option>
                </select>
              </div>

              <div class="mb-3">
                <label for="task-category" class="form-label">Category</label>
                <select
                  id="task-category"
                  name="task_category"
                  class="form-select"
                >
                  <option value="Development">Development</option>
                  <option value="Design">Design</option>
                  <option value="Testing">Testing</option>
                  <option value="Documentation">Documentation</option>
                </select>
              </div>

              <div class="mb-3">
                <label for="task-deadline" class="form-label">Deadline</label>
                <input
                  type="date"
                  id="task-deadline"
                  name="task_deadline"
                  class="form-control"
                />
              </div>

              <div class="mb-3">
                <label class="form-label">Assign to:</label>
                <% participants.forEach((participant) => { %>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="assigned_uid[]"
                    value="<%= participant.uid %>"
                    id="participant-<%= participant.uid %>"
                  />
                  <label
                    class="form-check-label"
                    for="participant-<%= participant.uid %>"
                  >
                    <%= participant.name %>
                  </label>
                </div>
                <% }); %>
              </div>

              <input type="hidden" name="projectId" value="<%= projectId %>" />
              <button type="submit" class="btn btn-primary w-100">
                Create Task
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Task List -->
      <div class="col-md-8">
        <h4 class="text-center mb-4">Task List</h4>

        <% if (tasks.length === 0) { %>
        <div class="alert alert-info text-center py-5">
          <div class="mb-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="text-muted"
              width="40"
              height="40"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
          </div>
          <h5>No tasks yet</h5>
          <p>Get started by creating a new task.</p>
        </div>
        <% } else { %>
        <% tasks.forEach((task) => { %>
        <div class="card mb-4 task-card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <h5 class="card-title mb-0"><%= task.task_name %></h5>

              <!-- Update status form -->
              <form action="/projects/<%= projectId %>/tasks/update-status" method="POST" class="d-flex align-items-center gap-2">
                <input type="hidden" name="task_id" value="<%= task.tid %>" />
                <select name="status" class="form-select form-select-sm">
                  <option value="Pending" <%= task.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="In Progress" <%= task.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                  <option value="Completed" <%= task.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                </select>
                <button class="btn btn-outline-secondary btn-sm" type="submit">Update</button>
              </form>

              <% if (task.priority) { %>
              <span
                class="badge
                <%= task.priority === 'High'
                  ? 'bg-danger'
                  : task.priority === 'Medium'
                  ? 'bg-warning text-dark'
                  : 'bg-success' %>"
                ><%= task.priority %></span
              >
              <% } %>
              <% if (task.category) { %>
              <span class="badge bg-info text-dark ms-2"><%= task.category %></span>
              <% } %>
            </div>

            <% if (task.task_description) { %>
            <p class="mt-2 text-muted"><%= task.task_description %></p>
            <% } %>

            <div class="mt-3">
              <div class="d-flex justify-content-end">
                <span class="badge bg-secondary me-2">
                  <strong>Deadline:</strong>
                  <%= task.deadline
                    ? new Date(task.deadline).toLocaleDateString()
                    : 'N/A' %>
                </span>
              </div>
            </div>

            <div class="mt-3">
              <p class="mb-0">
                <strong>Assigned To:</strong>
                <% if (task.assigned_user_names) { %>
                <%= task.assigned_user_names %>
                <% } else { %>
                <em class="text-muted">Not assigned</em>
                <% } %>
              </p>
            </div>
          </div>
        </div>
        <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
  ></script>
</body>
</html>
