<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Password Reset</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-light">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <i class="bi bi-diagram-3-fill me-2"></i>ProCollab
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a href="/login" class="btn btn-light me-2 fw-semibold">
              <i class="bi bi-box-arrow-in-right me-1"></i>Login
            </a>
          </li>
          <li class="nav-item">
            <a href="/signup" class="btn btn-warning fw-semibold">
              <i class="bi bi-person-plus-fill me-1"></i>Signup
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Container -->
  <div class="container mt-5">
    <h3 class="mb-4"><i class="bi bi-key-fill me-2"></i>Password Reset</h3>

    <% if (typeof message !== "undefined" && message) { %>
      <div class="alert alert-warning"><%= message %></div>
    <% } %>

    <!-- Email Form -->
    <% if (!phase) { %>
      <form method="POST" action="/send-code" class="card p-4 shadow-lg border-1">
        <div class="mb-3">
          <label class="form-label">Your Email</label>
          <input type="email" name="email" placeholder="Enter your email" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Send Verification Code</button>
      </form>
    <% } %>

    <!-- Modal: Verify Code -->
    <% if (phase === 'code') { %>
      <div class="modal fade show" style="display:block;" tabindex="-1" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-1 shadow-lg">
            <div class="modal-header bg-primary text-white">
              <h5 class="modal-title"><i class="bi bi-shield-lock-fill me-2"></i>Verify Code</h5>
              <button type="button" class="btn-close btn-close-white" onclick="window.location.href='/change-password'"></button>
            </div>
            <div class="modal-body">
              <form method="POST" action="/verify-code">
                <div class="mb-3">
                  <label class="form-label">6-digit Code</label>
                  <input type="text" name="code" class="form-control" required />
                </div>
                <button class="btn btn-success w-100">Verify</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Modal: New Password -->
    <% if (phase === 'password') { %>
      <div class="modal fade show" style="display:block;" tabindex="-1" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-info text-white">
              <h5 class="modal-title"><i class="bi bi-lock-fill me-2"></i>Set New Password</h5>
              <button type="button" class="btn-close btn-close-white" onclick="window.location.href='/change-password'"></button>
            </div>
            <div class="modal-body">
              <form method="POST" action="/set-new-password">
                <div class="mb-3">
                  <label class="form-label">New Password</label>
                  <input type="password" name="password" class="form-control" required />
                </div>
                <div class="mb-3">
                  <label class="form-label">Confirm Password</label>
                  <input type="password" name="confirm" class="form-control" required />
                </div>
                <button class="btn btn-info w-100">Reset Password</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Success Message -->
    <% if (phase === 'success') { %>
      <div class="alert alert-success mt-3">
        ✅ Password successfully updated. <a href="/login" class="alert-link">Login</a>
      </div>
    <% } %>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
